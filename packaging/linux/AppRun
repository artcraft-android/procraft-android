#!/usr/bin/env bash
# The AppImage's entry point. First it gives this user ProCraft's menu entry and icons (into
# $XDG_DATA_HOME, its Exec this AppImage wherever it now is): the app menus list it, and Wayland
# desktops find the window's icon through its app id (procraft) only that way. Then it runs the app.
HERE="$(dirname "$(readlink -f "$0")")"
if [ -n "${APPIMAGE:-}" ] && [ -n "${HOME:-}" ]; then
  DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
  {
    for icon in "$HERE"/usr/share/icons/hicolor/*/apps/procraft.png; do
      size="$(basename "$(dirname "$(dirname "$icon")")")"
      mkdir -p "$DATA/icons/hicolor/$size/apps" && cp -f "$icon" "$DATA/icons/hicolor/$size/apps/procraft.png"
    done
    mkdir -p "$DATA/applications" &&
      sed "s|^Exec=.*|Exec=\"$APPIMAGE\" %F|" "$HERE/procraft.desktop" >"$DATA/applications/procraft.desktop"
  } 2>/dev/null
fi
exec "$HERE/usr/bin/procraft" "$@"
