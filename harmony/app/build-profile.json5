{
  "app": {
    // DevEco Studio's signing (File > Project Structure > Signing Configs) writes the keys' paths
    // and passwords here: keep them out of commits (see ../README.md)
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // HarmonyOS 5.0.3 (API 15): the pen's hover moves (onHoverMove) and touch pressure; API 12
        // brought the release without Android and the surface id call
        "compatibleSdkVersion": "5.0.3(15)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
