# DRAFT of a GitHub Actions job that builds ProCraft's HarmonyOS packages. It isn't under
# .github/workflows, so nothing runs it: moved there, it would need the secrets below and a copy of
# Huawei's command-line tools. Untested: no step here has run.
#
# How a HarmonyOS release is made:
# - Packages:
#   - Each module of the app (ours: `entry`) builds into a .hap, a zip that `hdc install` puts on a
#     device in developer mode for testing.
#   - The .app ("App Pack") holds every .hap of a release and is what AppGallery Connect takes.
#   - Shared code goes into .har (static) or .hsp (shared) packages; ProCraft has none.
#   - hvigorw builds them: `assembleHap` for a module's .hap, `assembleApp` for the .app.
# - Signing, with three files:
#   - the key, kept in a keystore (.p12);
#   - the certificate AppGallery Connect issues for that key from its CSR (.cer);
#   - the profile it issues for the app's bundle name (.p7b).
# - Debug vs release:
#   - Debug certificates and profiles last 1 year for a verified developer (14 days otherwise). A
#     debug-signed .hap installs only on the devices whose UDIDs the profile lists.
#   - Release ones last 3 years and are what AppGallery takes. A release-signed package reaches
#     users through AppGallery (or enterprise distribution), not as a download.
#   - So a .hap attached to a GitHub release is useful unsigned, for people to sign with their own
#     Huawei ID in DevEco Studio, or debug-signed for listed testers' devices.
# - Huawei's command-line tools (ohpm, hvigorw, hdc, codelinter and the SDK with hap-sign-tool):
#   - They come from developer.huawei.com behind a Huawei ID sign-in and a licence agreement, for
#     Linux x86_64, Windows and macOS. Runner: ubuntu (x86_64), JDK 21 for tools 26.0.0 and later,
#     libGL for texture compression.
#   - Their licence wasn't read here. Third-party mirrors on GitHub repack them; this draft doesn't
#     use them. It fetches the official zip from a private place of our own (HARMONY_TOOLS_URL,
#     checked against HARMONY_TOOLS_SHA256), where the licence allows that.
#   - Whether keeping that copy (or an Actions cache of it) is allowed has to be checked in the
#     agreement first.
#
# Secrets (base64 for files):
#   HARMONY_TOOLS_URL        where our copy of the Linux command-line tools zip is
#   HARMONY_P12              release keystore (.p12)
#   HARMONY_CER              release certificate from AppGallery Connect (.cer)
#   HARMONY_P7B              release profile from AppGallery Connect (.p7b)
#   HARMONY_KEY_ALIAS        the key's alias in the keystore
#   HARMONY_KEY_PASSWORD     the key's password
#   HARMONY_STORE_PASSWORD   the keystore's password
# Variables:
#   HARMONY_TOOLS_SHA256     the zip's checksum
#
# Signing in this draft:
# - The .hap: built unsigned, then signed with the SDK's hap-sign-tool, which takes plain passwords
#   (OpenHarmony's hapsigntool guide).
# - The .app: hvigor signs it while building from build-profile.json5's signingConfigs. Their
#   passwords are encrypted by DevEco Studio with key material it keeps next to them, so that config
#   and its material folder would come from secrets too. That step is only sketched here, and the
#   .app stays unsigned below.
#
# Sources: OpenHarmony docs (application-package-overview.md, hapsigntool-guidelines.md); Huawei's
# "Building an app from the command line" (ide-command-line-building-app) and the AppGallery
# Connect release FAQ (certificate validity); the setup-ohos action's README (runner dependencies).

name: HarmonyOS

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  harmony:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Runner dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libgl1 unzip

      - name: Rust for HarmonyOS
        run: |
          rustup target add aarch64-unknown-linux-ohos
          cargo install ohrs --locked --version 1.5.0

      - name: Huawei's command-line tools (our copy of the official zip)
        env:
          HARMONY_TOOLS_URL: ${{ secrets.HARMONY_TOOLS_URL }}
          HARMONY_TOOLS_SHA256: ${{ vars.HARMONY_TOOLS_SHA256 }}
        run: |
          curl -fsSL "$HARMONY_TOOLS_URL" -o "$RUNNER_TEMP/tools.zip"
          echo "$HARMONY_TOOLS_SHA256  $RUNNER_TEMP/tools.zip" | sha256sum -c
          unzip -q "$RUNNER_TEMP/tools.zip" -d "$RUNNER_TEMP/hos"
          TOOLS="$RUNNER_TEMP/hos/command-line-tools"
          echo "$TOOLS/bin" >> "$GITHUB_PATH"
          echo "$TOOLS/tool/node/bin" >> "$GITHUB_PATH"
          echo "DEVECO_SDK_HOME=$TOOLS/sdk" >> "$GITHUB_ENV"
          echo "OHOS_NDK_HOME=$TOOLS/sdk/default/openharmony" >> "$GITHUB_ENV"
          echo "HAP_SIGN_TOOL=$TOOLS/sdk/default/openharmony/toolchains/lib/hap-sign-tool.jar" >> "$GITHUB_ENV"

      - name: The native library and the icons
        run: harmony/build-rust.sh arm64

      - name: The packages, unsigned
        working-directory: harmony/app
        run: |
          ohpm install
          hvigorw assembleHap --mode module -p module=entry@default -p product=default -p buildMode=release --no-daemon
          hvigorw assembleApp --mode project -p product=default -p buildMode=release --no-daemon

      - name: The .hap signed with the release key
        env:
          HARMONY_P12: ${{ secrets.HARMONY_P12 }}
          HARMONY_CER: ${{ secrets.HARMONY_CER }}
          HARMONY_P7B: ${{ secrets.HARMONY_P7B }}
          HARMONY_KEY_ALIAS: ${{ secrets.HARMONY_KEY_ALIAS }}
          HARMONY_KEY_PASSWORD: ${{ secrets.HARMONY_KEY_PASSWORD }}
          HARMONY_STORE_PASSWORD: ${{ secrets.HARMONY_STORE_PASSWORD }}
        run: |
          KEYS="$RUNNER_TEMP/keys"
          mkdir -p "$KEYS"
          echo "$HARMONY_P12" | base64 -d > "$KEYS/release.p12"
          echo "$HARMONY_CER" | base64 -d > "$KEYS/release.cer"
          echo "$HARMONY_P7B" | base64 -d > "$KEYS/release.p7b"
          VERSION=$(sed -n 's/^procraft\.version=//p' android/gradle.properties | tr -d '\r')
          mkdir -p dist
          java -jar "$HAP_SIGN_TOOL" sign-app -mode localSign \
            -keyAlias "$HARMONY_KEY_ALIAS" -keyPwd "$HARMONY_KEY_PASSWORD" \
            -keystoreFile "$KEYS/release.p12" -keystorePwd "$HARMONY_STORE_PASSWORD" \
            -appCertFile "$KEYS/release.cer" -profileFile "$KEYS/release.p7b" \
            -signAlg SHA256withECDSA \
            -inFile harmony/app/entry/build/default/outputs/default/entry-default-unsigned.hap \
            -outFile "dist/procraft-$VERSION-harmonyos.hap"
          java -jar "$HAP_SIGN_TOOL" verify-app -inFile "dist/procraft-$VERSION-harmonyos.hap" \
            -outCertchain "$KEYS/chain.cer" -outProfile "$KEYS/profile.p7b"
          rm -rf "$KEYS"
          # the .app as built (unsigned): signed by hvigor once its signing config comes from
          # secrets, or by AppGallery Connect's cloud-managed certificate (tools 26.0.0 and later)
          cp harmony/app/build/outputs/default/*.app dist/

      - uses: actions/upload-artifact@v4
        with:
          name: procraft-harmonyos
          path: dist/
