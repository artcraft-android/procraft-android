{
  "schema": 1,
  "id": "io.github.artcraftandroid.extract-lines",
  "name": "Extract lines",
  "version": "1.0.0",
  "holds": ["filter"],
  "publisher": { "name": "ProCraft" },
  "description": "Keeps the dark lines of a scanned drawing and clears the paper, so you can colour under them.",
  "compat": { "procraft": { "interface": 1 } },
  "permissions": [],
  "controls": [
    { "key": "cut", "type": "slider", "label": "Paper", "least": 0, "most": 1, "step": 0.01, "starts": 0.15, "shown_times": 100, "unit": "%", "live": true },
    { "key": "soft", "type": "slider", "label": "Softness", "least": 0, "most": 0.5, "step": 0.01, "starts": 0.1, "shown_times": 100, "unit": "%", "live": true },
    { "key": "keep_colour", "type": "switch", "label": "Keep the colour", "starts": false }
  ]
}
