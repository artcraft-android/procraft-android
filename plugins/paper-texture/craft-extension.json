{
  "schema": 1,
  "id": "io.github.artcraftandroid.paper-texture",
  "name": "Paper texture",
  "version": "1.0.0",
  "holds": ["filter"],
  "publisher": { "name": "ProCraft" },
  "description": "Puts paper behind the layer's paint: a warm white with a grain of fibres. On an empty layer at the bottom, it's paper under your drawing.",
  "compat": { "procraft": { "interface": 1 } },
  "permissions": [],
  "controls": [
    { "key": "grain", "type": "slider", "label": "Grain", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true },
    { "key": "scale", "type": "slider", "label": "Scale", "least": 1, "most": 16, "step": 0.5, "starts": 3, "unit": " px", "live": true },
    { "key": "warmth", "type": "slider", "label": "Warmth", "least": 0, "most": 1, "step": 0.01, "starts": 0.3, "shown_times": 100, "unit": "%", "live": true }
  ]
}
