<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.ProCraft">

        <!-- configuration changes are handled in place: the canvas and its GPU state stay -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- a file opened with the app, or shared to it: artworks, packages and pictures go to the gallery -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
            </intent-filter>
            <!-- our own kinds of file by their names, whatever type the file manager gives them
                 (often none known for these), or none at all -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".procreate" />
                <data android:pathPattern=".*\\.procreate" />
                <data android:pathPattern=".*\\..*\\.procreate" />
                <data android:pathSuffix=".procraft" />
                <data android:pathPattern=".*\\.procraft" />
                <data android:pathPattern=".*\\..*\\.procraft" />
                <data android:pathSuffix=".procraft-plugin" />
                <data android:pathPattern=".*\\.procraft-plugin" />
                <data android:pathPattern=".*\\..*\\.procraft-plugin" />
                <data android:pathSuffix=".procraftplugin" />
                <data android:pathPattern=".*\\.procraftplugin" />
                <data android:pathPattern=".*\\..*\\.procraftplugin" />
                <data android:pathSuffix=".brush" />
                <data android:pathPattern=".*\\.brush" />
                <data android:pathPattern=".*\\..*\\.brush" />
                <data android:pathSuffix=".brushset" />
                <data android:pathPattern=".*\\.brushset" />
                <data android:pathPattern=".*\\..*\\.brushset" />
                <data android:pathSuffix=".swatches" />
                <data android:pathPattern=".*\\.swatches" />
                <data android:pathPattern=".*\\..*\\.swatches" />
                <data android:pathSuffix=".psd" />
                <data android:pathPattern=".*\\.psd" />
                <data android:pathPattern=".*\\..*\\.psd" />
                <data android:pathSuffix=".abr" />
                <data android:pathPattern=".*\\.abr" />
                <data android:pathPattern=".*\\..*\\.abr" />
                <data android:pathSuffix=".sut" />
                <data android:pathPattern=".*\\.sut" />
                <data android:pathPattern=".*\\..*\\.sut" />
                <data android:pathSuffix=".sutg" />
                <data android:pathPattern=".*\\.sutg" />
                <data android:pathPattern=".*\\..*\\.sutg" />
                <data android:pathSuffix=".kpp" />
                <data android:pathPattern=".*\\.kpp" />
                <data android:pathPattern=".*\\..*\\.kpp" />
                <data android:pathSuffix=".gbr" />
                <data android:pathPattern=".*\\.gbr" />
                <data android:pathPattern=".*\\..*\\.gbr" />
                <data android:pathSuffix=".gih" />
                <data android:pathPattern=".*\\.gih" />
                <data android:pathPattern=".*\\..*\\.gih" />
                <data android:pathSuffix=".vbr" />
                <data android:pathPattern=".*\\.vbr" />
                <data android:pathPattern=".*\\..*\\.vbr" />
                <data android:pathSuffix=".aco" />
                <data android:pathPattern=".*\\.aco" />
                <data android:pathPattern=".*\\..*\\.aco" />
                <data android:pathSuffix=".ase" />
                <data android:pathPattern=".*\\.ase" />
                <data android:pathPattern=".*\\..*\\.ase" />
                <data android:pathSuffix=".usdz" />
                <data android:pathPattern=".*\\.usdz" />
                <data android:pathPattern=".*\\..*\\.usdz" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathSuffix=".procreate" />
                <data android:pathPattern=".*\\.procreate" />
                <data android:pathPattern=".*\\..*\\.procreate" />
                <data android:pathSuffix=".procraft" />
                <data android:pathPattern=".*\\.procraft" />
                <data android:pathPattern=".*\\..*\\.procraft" />
                <data android:pathSuffix=".procraft-plugin" />
                <data android:pathPattern=".*\\.procraft-plugin" />
                <data android:pathPattern=".*\\..*\\.procraft-plugin" />
                <data android:pathSuffix=".procraftplugin" />
                <data android:pathPattern=".*\\.procraftplugin" />
                <data android:pathPattern=".*\\..*\\.procraftplugin" />
                <data android:pathSuffix=".brush" />
                <data android:pathPattern=".*\\.brush" />
                <data android:pathPattern=".*\\..*\\.brush" />
                <data android:pathSuffix=".brushset" />
                <data android:pathPattern=".*\\.brushset" />
                <data android:pathPattern=".*\\..*\\.brushset" />
                <data android:pathSuffix=".swatches" />
                <data android:pathPattern=".*\\.swatches" />
                <data android:pathPattern=".*\\..*\\.swatches" />
                <data android:pathSuffix=".psd" />
                <data android:pathPattern=".*\\.psd" />
                <data android:pathPattern=".*\\..*\\.psd" />
                <data android:pathSuffix=".abr" />
                <data android:pathPattern=".*\\.abr" />
                <data android:pathPattern=".*\\..*\\.abr" />
                <data android:pathSuffix=".sut" />
                <data android:pathPattern=".*\\.sut" />
                <data android:pathPattern=".*\\..*\\.sut" />
                <data android:pathSuffix=".sutg" />
                <data android:pathPattern=".*\\.sutg" />
                <data android:pathPattern=".*\\..*\\.sutg" />
                <data android:pathSuffix=".kpp" />
                <data android:pathPattern=".*\\.kpp" />
                <data android:pathPattern=".*\\..*\\.kpp" />
                <data android:pathSuffix=".gbr" />
                <data android:pathPattern=".*\\.gbr" />
                <data android:pathPattern=".*\\..*\\.gbr" />
                <data android:pathSuffix=".gih" />
                <data android:pathPattern=".*\\.gih" />
                <data android:pathPattern=".*\\..*\\.gih" />
                <data android:pathSuffix=".vbr" />
                <data android:pathPattern=".*\\.vbr" />
                <data android:pathPattern=".*\\..*\\.vbr" />
                <data android:pathSuffix=".aco" />
                <data android:pathPattern=".*\\.aco" />
                <data android:pathPattern=".*\\..*\\.aco" />
                <data android:pathSuffix=".ase" />
                <data android:pathPattern=".*\\.ase" />
                <data android:pathPattern=".*\\..*\\.ase" />
                <data android:pathSuffix=".usdz" />
                <data android:pathPattern=".*\\.usdz" />
                <data android:pathPattern=".*\\..*\\.usdz" />
            </intent-filter>
        </activity>

        <!-- the app's settings: also what Android's page for the app links to -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- the share sheet's Save to device: the system's picker over a see-through window -->
        <activity
            android:name=".SaveToDeviceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- the home screen's Recent artwork widget -->
        <receiver
            android:name=".gallery.RecentArtworkWidget"
            android:exported="true"
            android:label="@string/widget_recent_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent" />
        </receiver>

        <!-- hands exported pictures to other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
        <!-- artworks dragged out of the gallery, made when another app opens them -->
        <provider
            android:name=".gallery.DragProvider"
            android:authorities="${applicationId}.drag"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
